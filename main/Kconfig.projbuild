menu "Camera remote view"

    config APP_CAM_STREAM_URL
        string "Default MJPEG stream URL"
        default "http://192.168.4.1:81/stream"
        help
            Multipart MJPEG endpoint shown on the Cam Remote screen, e.g. an
            ESP32-CAM CameraWebServer at http://<ip>:81/stream. The URL can be
            edited on the device; the edited value is kept in NVS and takes
            precedence over this default.

endmenu

menu "Wi-Fi (ESP32-C6 via ESP-Hosted)"

    config APP_WIFI_SSID
        string "Network name (SSID)"
        default ""
        help
            Access point to join. The camera stream is fetched over this link.
            For an ESP32-CAM in its own AP mode this is the camera's SSID and
            the stream is at http://192.168.4.1:81/stream. Leave empty to keep
            Wi-Fi off.

    config APP_WIFI_PASSWORD
        string "Password"
        default ""
        help
            Empty for an open network.

endmenu
